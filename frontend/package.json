{
  "name": "thunder-ai",
  "version": "1.0.0",
  "private": true,
  "main": "public/electron.js",
  "homepage": "./",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "axios": "1.7.2",
    "framer-motion": "11.2.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.23.1",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "autoprefixer": "10.4.19",
    "concurrently": "8.2.2",
    "electron": "^31.0.2",
    "electron-builder": "24.13.3",
    "postcss": "8.4.38",
    "tailwindcss": "3.4.4",
    "wait-on": "7.2.0"
  },
  "build": {
    "appId": "com.thunderai.app",
    "productName": "Thunder AI",
    "files": [
      "build/**/*",
      "public/electron.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version"
    ]
  }
}
